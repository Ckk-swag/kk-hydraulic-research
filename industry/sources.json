    {
      "id": "bluerobotics-blueos-releases",
      "name": "Blue Robotics BlueOS · 水域机器人平台",
      "kind": "json_list",
      "config": {
        "url": "https://api.github.com/repos/bluerobotics/BlueOS/releases?per_page=30",
        "headers": { "User-Agent": "KaikaiWaterResearchBot" },
        "titlePaths": ["name", "tag_name"],
        "summaryPaths": ["body"],
        "publishedAtPath": "published_at",
        "externalIdPath": "id",
        "urlTemplate": "{raw:html_url}",
        "requireBoolean": { "path": "prerelease", "equals": false },
        "allowUrlPrefixes": ["https://github.com/bluerobotics/BlueOS/releases/tag/"],
        "sortByPublishedAt": true,
        "_aihot": { "initialBackfillLimit": 3 }
      },
      "tier": "T1_5",
      "first_party": true,
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 720,
      "tags": ["软件", "水利机器人"],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
